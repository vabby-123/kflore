# Copy this file to `.env` and replace the placeholders with your real values.

# PostgreSQL connection string. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# NextAuth session signing secret: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Used by `npm run db:seed` to create the first admin user.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Default WhatsApp number (E.164 digits, no +) before Contact Settings are configured in /admin.
WHATSAPP_NUMBER=""

# Cloudinary (optional) — falls back to local /public/uploads storage when empty.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (optional) — contact-form enquiries are always saved to the DB regardless.
RESEND_API_KEY=""
BUSINESS_EMAIL=""

# Billplz (online payment). Leave BILLPLZ_API_KEY / BILLPLZ_COLLECTION_ID empty to keep
# "Pay Online" hidden storefront-wide and fall back to WhatsApp ordering only.
# See README "Online Payment (Billplz)" for how to get these from your Billplz account.
BILLPLZ_API_KEY=""
BILLPLZ_COLLECTION_ID=""
BILLPLZ_X_SIGNATURE_KEY=""
# "true" (default) uses https://www.billplz-sandbox.com — set to "false" only with a live Billplz account.
BILLPLZ_SANDBOX="true"
